RewriteEngine On
RewriteBase /

# Block source, documentation, runtime data, and local configuration from HTTP.
RewriteRule ^(?:app|config|database|docs|scripts|tests|private-runtime)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.gdp_backups|\.gdp_task[^/]*)(?:/|$) - [F,L,NC]
RewriteRule ^api/data(?:/|$) - [F,L,NC]
RewriteRule ^api/(?:bootstrap|config|db|mailer)\.php$ - [F,L,NC]

<FilesMatch "(?i)(^\.env|\.(?:sql|sqlite|sqlite3|log|bak|sh|py|md)$)">
  Require all denied
</FilesMatch>

# 1. Enforce HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Clean URLs (Menghilangkan ekstensi .html di URL)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^editor$ editor.html [NC,L]
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# 3. Index File Fallback
DirectoryIndex index.html index.php cv.html

# 4. Encoding UTF-8
AddDefaultCharset UTF-8

# Safe baseline headers. A strict CSP follows after inline handlers are removed.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
